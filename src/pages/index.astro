---
// Ottilie Ohm: notepad-style about / media portfolio / contact page.
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" href="/favicon.ico" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="generator" content={Astro.generator} />
  <title>Ottilie Ohm</title>
  <meta name="description" content="Ottilie Ohm: Schwarzman Scholar and Fulbright grantee working across technology, international affairs, and digital storytelling. About, media portfolio, and contact." />
  <meta property="og:title" content="Ottilie Ohm" />
  <meta property="og:description" content="About, media portfolio, and contact." />
  <meta property="og:type" content="website" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fanwood+Text:ital@0;1&display=swap" rel="stylesheet" />
  <style is:global>
    /* page defaults (the Artifact viewer used to supply these) */
    :root { color-scheme: light; padding-top: env(safe-area-inset-top, 0px); padding-bottom: env(safe-area-inset-bottom, 0px); }
    body { font-size: 14px; }
    img { max-width: 100%; }
    [hidden] { display: none !important; }

  :root {
    --face: #E4E4E2;
    --hi: #FFFFFF;
    --sh: #9A9A9A;
    --sh2: #000000;
    --paper: #FFFFFF;
    --desk: #FFFFFF;
    --ink: #000000;
    --mute: #6B6B6B;
    --accent: #B53D3B;
  }

  * { box-sizing: border-box; }

  html, body { height: 100%; }

  body {
    margin: 0;
    background: var(--desk);
    color: var(--ink);
    font-family: 'Fanwood Text', Georgia, 'Times New Roman', serif;
  }

  h1, h2 { text-wrap: balance; }

  .chrome-text {
    font-family: 'Fanwood Text', Georgia, 'Times New Roman', serif;
  }

  /* ---- flat, double-ruled chrome: two real bordered boxes with a gap between ---- */
  .raised {
    background: var(--face);
    border: 1px solid var(--sh2);
  }
  .inner-frame {
    background: var(--paper);
    border: 1px solid var(--sh2);
  }
  .sunken {
    background: var(--paper);
    border: 1px solid var(--sh2);
  }
  .sunken-shallow {
    background: var(--paper);
    border: 1px solid var(--sh2);
  }
  .photo-frame {
    background: var(--paper);
    border: 3px solid var(--accent);
  }

  .desktop-frame {
    display: flex;
    align-items: stretch;
    min-height: 100vh;
  }

  .side-strip { flex: none; background: var(--paper); }
  .side-strip.left {
    width: 26px;
    border-right: 1px solid var(--sh2);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    padding: 10px 0;
  }
  .strip-arrow { font-size: 8px; line-height: 1; color: var(--mute); }
  .strip-label {
    writing-mode: vertical-rl;
    text-orientation: mixed;
    font-size: 10px;
    letter-spacing: 0.05em;
    color: var(--mute);
  }

  .main-col { flex: 1 1 auto; min-width: 0; padding: 10px; }

  .contact-list { margin: 0; font-size: 14px; line-height: 1.6; max-width: 40ch; }
  .contact-list dt { font-weight: 600; margin-top: 16px; }
  .contact-list dt:first-child { margin-top: 0; }
  .contact-list dd { margin: 0; color: var(--mute); word-break: break-word; }
  .contact-link { color: var(--accent); }

  .contact-form { max-width: 520px; margin: 0 0 8px; }
  .contact-form .field { margin-bottom: 14px; }
  .contact-form label { display: block; font-size: 13px; font-weight: 600; margin-bottom: 4px; }
  .contact-form .hint { font-weight: 400; font-style: italic; color: var(--mute); }
  .contact-form input,
  .contact-form textarea {
    width: 100%;
    font: inherit;
    font-size: 14px;
    padding: 8px 10px;
    border: 1px solid var(--sh2);
    background: #fff;
    color: var(--ink);
    border-radius: 0;
  }
  .contact-form textarea { resize: vertical; min-height: 120px; }
  .contact-form input:focus-visible,
  .contact-form textarea:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
  .contact-form [aria-invalid="true"] { border-color: var(--accent); box-shadow: 0 0 0 1px var(--accent); }
  .form-btn {
    font: inherit;
    font-size: 13px;
    padding: 8px 20px;
    border: 1.5px solid var(--accent);
    background: #fff;
    color: var(--accent);
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .form-btn:hover { background: var(--accent); color: #fff; }
  .form-btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .form-status { margin: 10px 0 0; min-height: 1.4em; font-size: 13px; font-style: italic; color: var(--accent); }
  .section-label.elsewhere { margin-top: 28px; }

  .outer-window { width: 100%; padding: 3px; background: var(--accent); }

  .outer-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    background: var(--paper);
    border-bottom: 1px solid var(--sh2);
  }
  .outer-titlebar-label {
    grid-column: 2;
    grid-row: 1;
    padding: 14px 24px;
    font-size: 38px;
    letter-spacing: 0.04em;
    white-space: nowrap;
    text-align: center;
  }

  .tabrow {
    grid-column: 1;
    grid-row: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 22px;
    padding: 8px 18px;
  }
  .tab {
    font-size: 16px;
    font-style: italic;
    color: var(--mute);
    letter-spacing: 0.02em;
  }
  .tab.active {
    font-style: normal;
    font-weight: 700;
    color: var(--ink);
    text-decoration: underline;
  }
  .tab[data-tab] { cursor: pointer; user-select: none; }
  .tab-panel[hidden] { display: none; }

  .outer-content { background: var(--paper); padding: 10px; }

  .window { width: 100%; }
  .tab-panel .window,
  .tab-panel .window > .inner-frame,
  .tab-panel .content-surface {
    background: transparent;
    border: none;
  }

  .content-surface { padding: 14px 10px 6px; }

  .media-list-simple {
    display: flex;
    flex-direction: column;
    gap: 56px;
    margin-top: 26px;
  }
  .media-section {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
    gap: 28px;
    align-items: center;
  }
  .media-pair {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 36px;
    align-items: stretch;
  }
  .media-frame {
    position: relative;
    background: var(--paper);
    border: 1.4px solid var(--sh2);
    border-top: none;
    margin-top: 34px;
    padding: 34px 24px 24px;
    --tab-left: 18px;
    --tab-width: 96px;
    --tab-font: clamp(21px, 3vw, 31.5px);
    --tab-h: calc(var(--tab-font) + 19.5px);
  }
  .media-frame::after {
    content: "";
    position: absolute;
    top: -1.4px;
    left: -1.4px;
    right: -1.4px;
    height: 1.4px;
    background: linear-gradient(
      to right,
      var(--sh2) 0, var(--sh2) var(--tab-left),
      transparent var(--tab-left), transparent calc(var(--tab-left) + var(--tab-width)),
      var(--sh2) calc(var(--tab-left) + var(--tab-width)), var(--sh2) 100%
    );
  }
  .tab-label {
    position: absolute;
    top: calc(-1 * var(--tab-h));
    height: var(--tab-h);
    left: var(--tab-left);
    max-width: calc(100% - var(--tab-left) - 12px);
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    white-space: nowrap;
    overflow: hidden;
    padding: 0 calc(var(--tab-h) + 6px);
    font-family: 'Fanwood Text', Georgia, 'Times New Roman', serif;
    font-size: var(--tab-font);
    font-style: normal;
    letter-spacing: -0.01em;
    color: var(--ink);
    z-index: 1;
    background-repeat: no-repeat;
  }
  .media-frame.tab-b { --tab-left: 34px; }
  .media-frame.tab-c { --tab-left: 26px; }
  .media-frame.tab-d { --tab-left: 46px; }
  .media-frame.tab-e { --tab-left: 20px; }
  .media-frame.tab-f { --tab-left: 38px; }
  .bio.release-note { margin-top: 1.65em; font-style: italic; color: var(--accent); }
  .still-photo {
    display: block;
    width: 480px;
    max-width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border: 1px solid var(--sh2);
  }

  .article-list { margin: 14px 0 0; }
  .article-row {
    display: block;
    padding: 8px 0;
    border-top: 1px dotted var(--sh);
    color: inherit;
    text-decoration: none;
    font-size: 13px;
  }
  .article-list a.article-row:hover .article-title-line { text-decoration: underline; }
  .article-row:last-child { border-bottom: 1px dotted var(--sh); }
  .article-head { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
  .article-title-line { font-weight: 600; }
  .article-date { color: var(--mute); white-space: nowrap; font-variant-numeric: tabular-nums; font-size: 12px; }
  .article-sub { color: var(--mute); font-size: 12px; margin-top: 2px; line-height: 1.45; }
  .more-link {
    display: block;
    width: fit-content;
    margin-top: 12px;
    font-size: 13px;
    color: var(--accent);
  }

  .media-sub-label {
    font-size: 12px;
    font-weight: 600;
    text-decoration: underline;
    letter-spacing: 0.02em;
    margin: 18px 0 8px;
  }

  .media-box {
    border: 2px solid var(--accent);
    padding: 6px 8px 8px;
    margin-top: 14px;
    display: inline-block;
    max-width: 100%;
    box-sizing: border-box;
  }
  .media-section > .media-box,
  .media-section > div:last-child > .media-box:first-child { margin-top: 0; }

  .mav-video-frame {
    position: relative;
    display: block;
    width: 480px;
    max-width: 100%;
    aspect-ratio: 16/9;
    border: 1px solid var(--sh2);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .mav-video-frame:hover { transform: scale(1.015); box-shadow: 0 4px 14px rgba(0,0,0,0.18); }
  .mav-video-frame img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.25s ease; }
  .mav-video-frame:hover img { transform: scale(1.05); }
  .mav-play {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    width: 46px; height: 46px;
    border-radius: 50%;
    background: rgba(0,0,0,0.6);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-size: 16px;
    transition: background 0.2s ease, transform 0.2s ease;
  }
  .mav-video-frame:hover .mav-play { background: rgba(0,0,0,0.78); transform: translate(-50%, -50%) scale(1.08); }

  /* ---- carousel ---- */
  /* Definite width: the box shrink-wraps its content, so without this the
     carousel (and its aspect-ratio image frame) resized with each caption. */
  .carousel { width: 480px; max-width: 100%; }
  .carousel-frame {
    position: relative;
    border: 1px solid var(--sh2);
    background: var(--face);
    overflow: hidden;
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .carousel-frame:hover { transform: scale(1.015); box-shadow: 0 4px 14px rgba(0,0,0,0.18); }
  [data-carousel="kennan"] .carousel-frame { background: #000; }
  .carousel-frame img { width: 100%; height: 100%; display: block; object-fit: cover; transition: transform 0.25s ease; }
  .carousel-frame:hover img { transform: scale(1.04); }
  .carousel-caption { font-size: 12px; color: var(--mute); margin-top: 6px; min-height: 1.5em; }
  [data-carousel="kennan"] .carousel-caption { min-height: 3em; }
  .carousel-controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 6px;
  }
  .carousel-btn {
    width: 24px;
    height: 24px;
    border: 1.5px solid var(--accent);
    background: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    font-weight: 700;
    color: var(--accent);
    line-height: 1;
    cursor: pointer;
  }
  .carousel-dots { display: flex; gap: 5px; }
  .carousel-dots .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--sh);
    cursor: pointer;
  }
  .carousel-dots .dot.active { background: var(--accent); }

  /* ---- expandable clip grid ---- */
  .clip-grid {
    max-width: 480px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
  }
  .clip-grid[hidden] { display: none; }
  .clip-tile {
    position: relative;
    aspect-ratio: 9 / 16;
    border: 1px solid var(--sh2);
    padding: 0;
    margin: 0;
    cursor: pointer;
    overflow: hidden;
    background: var(--face);
    font: inherit;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .clip-tile:hover { transform: scale(1.035); box-shadow: 0 4px 14px rgba(0,0,0,0.2); z-index: 1; }
  .clip-tile img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.25s ease; }
  .clip-tile:hover img { transform: scale(1.08); }
  .clip-tile .clip-caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(255, 255, 255, 0.92);
    border-top: 1px solid var(--sh2);
    font-size: 9px;
    line-height: 1.25;
    padding: 3px 4px;
    color: var(--ink);
  }
  .clip-detail {
    max-width: 480px;
    border: 1px solid var(--accent);
    padding: 14px;
  }
  .clip-back {
    display: inline-block;
    font-size: 12px;
    color: var(--mute);
    cursor: pointer;
    margin-bottom: 10px;
  }
  .clip-detail-thumb {
    width: 100%;
    max-width: 180px;
    display: block;
    border: 1px solid var(--sh2);
    margin-bottom: 10px;
  }
  .clip-detail-title { font-weight: 600; font-size: 14px; margin-bottom: 4px; }
  .clip-detail-desc { font-size: 12.5px; color: var(--mute); line-height: 1.55; margin-bottom: 10px; }
  .clip-watch-link { display: inline-block; color: var(--accent); font-size: 12.5px; }

  .top-row {
    display: grid;
    grid-template-columns: minmax(170px, 225px) 1fr;
    gap: 36px;
    align-items: center;
  }

  .headline {
    font-family: 'Fanwood Text', Georgia, 'Times New Roman', serif;
    font-style: normal;
    font-weight: 400;
    font-size: 40px;
    line-height: 1;
    letter-spacing: -0.01em;
    margin: 0 0 14px;
  }

  .photo-box {
    aspect-ratio: 1201 / 1600;
    position: relative;
    overflow: visible;
  }
  .photo-box span {
    font-size: 11px;
    color: var(--accent);
    letter-spacing: 0.02em;
    font-family: 'Fanwood Text', serif;
  }
  .photo-box img {
    position: absolute;
    inset: 6px;
    width: calc(100% - 12px);
    height: calc(100% - 12px);
    object-fit: cover;
    transform: rotate(-3deg) scale(1.05);
    transform-origin: center;
  }

  .top-row .bio { max-width: none; padding-right: 96px; }

  .bio {
    font-size: 14px;
    line-height: 1.65;
    margin: 0;
    max-width: 62ch;
  }

  .section-label {
    font-size: 14px;
    font-weight: 600;
    text-decoration: underline;
    margin: 0 0 8px;
  }

  .two-col {
    margin-top: 26px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px;
  }

  .sub-label { font-size: 13px; margin: 10px 0 2px; }
  ul.plain {
    list-style: none;
    margin: 0 0 6px;
    padding: 0;
    font-size: 13px;
    line-height: 1.55;
  }
  ul.plain.indent { padding-left: 18px; }

  .lang-list { padding-left: 18px; }
  .lang-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 10px;
    font-size: 13px;
    line-height: 1.55;
    max-width: 185px;
  }
  .lang-level { color: var(--mute); font-weight: 700; letter-spacing: 0.05em; }

  .edu-entry, .ach-entry { margin-bottom: 14px; font-size: 13px; line-height: 1.5; }
  .edu-entry .role, .ach-entry .role { font-weight: 600; }
  .edu-entry .meta, .ach-entry .meta { color: var(--mute); }
  .detail-line { font-size: 12px; line-height: 1.5; margin-top: 3px; font-style: italic; color: var(--mute); }

  .experience { margin-top: 24px; }
  .exp-row {
    border-top: 1px dotted var(--sh);
    padding: 9px 8px;
    margin: 0 -8px;
    font-size: 13px;
    line-height: 1.55;
    cursor: pointer;
    transition: background 0.15s ease;
  }
  .exp-row:hover { background: color-mix(in srgb, var(--accent) 7%, transparent); }
  .exp-row-head:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .exp-row:last-child { border-bottom: 1px dotted var(--sh); }
  .exp-row-head {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .exp-lines { flex: 1; min-width: 0; }
  .exp-line {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 10px;
  }
  .exp-role { font-weight: 600; }
  .exp-org { color: var(--mute); }
  .exp-loc { white-space: nowrap; color: var(--mute); }
  .exp-date { white-space: nowrap; font-variant-numeric: tabular-nums; color: var(--mute); }
  .exp-detail {
    display: none;
    margin: 10px 0 2px;
    font-size: 12.5px;
    line-height: 1.6;
    border-left: 2px solid var(--face);
    padding-left: 12px;
  }
  .exp-row.open .exp-detail { display: block; }
  .exp-detail ul { margin: 0; padding-left: 16px; }

  .statusbar {
    height: 22px;
    margin-top: 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 4px;
  }
  .statusbar span {
    height: 100%;
    display: flex;
    align-items: center;
    padding: 0 10px;
    font-size: 11px;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 1240px) {
    .outer-header { grid-template-columns: 1fr; }
    .outer-titlebar-label { grid-column: 1; grid-row: 1; border-bottom: 1px solid var(--sh2); }
    .tabrow { grid-column: 1; grid-row: 2; justify-content: center; }
  }

  @media (max-width: 900px) {
    .top-row .bio { padding-right: 0; }
    .desktop-frame { flex-direction: column; }
    .side-strip.left { display: none; }
  }

  @media (max-width: 640px) {
    .top-row { grid-template-columns: 1fr; }
    .photo-box { max-width: 180px; }
    .two-col { grid-template-columns: 1fr; }
    .content-surface { padding: 14px 12px 6px; }
    .main-col { padding: 10px; }
    .media-section { grid-template-columns: 1fr; }
    .media-pair { grid-template-columns: 1fr; gap: 56px; }
  }
  </style>
</head>
<body>
<div class="desktop-frame">
  <div class="side-strip left">
    <span class="strip-arrow">&#9650;</span>
    <span class="strip-label">file 1</span>
    <span class="strip-arrow">&#9660;</span>
  </div>

  <div class="main-col">
    <div class="outer-window raised">
     <div class="inner-frame">
      <div class="outer-header chrome-text">
        <span class="outer-titlebar-label">OTTILIE OHM</span>
        <div class="tabrow" role="tablist" aria-label="Site sections">
          <span class="tab active" role="tab" id="tab-about" data-tab="about" aria-controls="panel-about" aria-selected="true" tabindex="0">ABOUT ME</span>
          <span class="tab" role="tab" id="tab-media" data-tab="media" aria-controls="panel-media" aria-selected="false" tabindex="-1">MEDIA PORTFOLIO</span>
          <span class="tab" role="tab" id="tab-contact" data-tab="contact" aria-controls="panel-contact" aria-selected="false" tabindex="-1">CONTACT</span>
        </div>
      </div>

      <div class="outer-content">

  <div class="tab-panel" data-panel="about" id="panel-about" role="tabpanel" aria-labelledby="tab-about" tabindex="0">
  <div class="window raised">
   <div class="inner-frame">
    <div class="content-surface sunken">
      <div class="top-row">
        <div class="photo-box photo-frame">
          <img src="/img/ottilie-portrait.jpg" alt="Ottilie Ohm" />
        </div>

        <div>
          <h1 class="headline">about Ottilie</h1>
          <p class="bio">
            Hi, I'm Ottilie &mdash; a Schwarzman Scholar and Fulbright grantee whose work has spanned
            technology, international affairs, and operational problem-solving across four continents.
            My degree in Information Technology Innovation fused entrepreneurship with technical fluency,
            a combination I've applied everywhere from building automation systems at a defense contractor
            to founding Central Asia's first international women's lacrosse competition &mdash; and, most days,
            to turning research and reporting into video and writing people actually finish.
          </p>
        </div>
      </div>

      <div class="two-col">
        <div>
          <p class="section-label">SKILLS:</p>
          <p class="sub-label">technical &gt;</p>
          <ul class="plain indent">
            <li>Adobe Suite, Final Cut Pro</li>
            <li>Canva, CapCut</li>
            <li>Python, HTML/CSS</li>
          </ul>
