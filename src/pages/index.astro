  function initClipGrid(prefix) {
    var grid = document.querySelector('[data-clipgrid="' + prefix + '"]');
    var detail = document.querySelector('[data-clipdetail="' + prefix + '"]');
    if (!grid || !detail) return;
    var config = clipData[prefix];
    config.items.forEach(function (item, i) {
      var tile = document.createElement('button');
      tile.type = 'button';
      tile.className = 'clip-tile';
      var img = document.createElement('img');
      img.src = item.thumb;
      img.alt = item.title;
      var cap = document.createElement('span');
      cap.className = 'clip-caption';
      cap.textContent = item.title;
      tile.appendChild(img);
      tile.appendChild(cap);
      tile.addEventListener('click', function () { openDetail(i); });
      grid.appendChild(tile);
    });
    function openDetail(i) {
      var item = config.items[i];
      detail.querySelector('.clip-detail-thumb').src = item.thumb;
      detail.querySelector('.clip-detail-title').textContent = item.title;
      detail.querySelector('.clip-detail-desc').textContent = item.desc;
      detail.querySelector('.clip-watch-link').href = 'https://www.tiktok.com/@' + config.account + '/video/' + item.videoId;
      grid.hidden = true;
      detail.hidden = false;
    }
    detail.querySelector('.clip-back').addEventListener('click', function () {
      detail.hidden = true;
      grid.hidden = false;
    });
  }

  initClipGrid('bs');
  initClipGrid('edu');

  // Builds the trapezoid outline as a background-image SVG whose viewBox
  // matches the tab's real pixel width/height exactly. That keeps the CSS
  // background-size:100% 100% stretch uniform on both axes, so the stroke
  // renders the same true thickness everywhere — previously the shape used
  // one fixed wide/short viewBox for every tab, stretched non-uniformly to
  // fit each tab's actual (very different) box, which scaled diagonal
  // strokes differently than horizontal ones and made the outline look
  // thick in some spots and thin in others.
  function tabShapeUrl(w, h) {
    w = Math.max(1, Math.round(w));
    h = Math.max(1, Math.round(h));
    // 1.4 to match .media-frame's own border weight exactly, so the tab
    // outline and the box it sits on read as the same line.
    var sw = 1.4;
    var half = sw / 2;
    var x0 = 1;                         // where each side meets the frame line
    var e = 3;                          // sides run a little past the bottom; the box clips them flat
    var r = 16;                         // top-corner rounding radius
    // The slant is tied to the tab's HEIGHT, not its width: horizontal run
    // equals vertical rise, so every side is 45 degrees no matter how long
    // the title is. (Slanting by a fraction of the width made the angle
    // change with the text length.)
    var run = h - half;
    var tx1 = x0 + run, tx2 = w - x0 - run, ty = half;
    // Rounding a corner whose sides turn by 45 degrees: the curve starts and
    // ends t away from the corner point.
    var t = r * Math.tan(Math.PI / 8), k = t * Math.SQRT1_2;
    // One open path carries both the white fill and the black stroke, so the
    // outline sits on the fill's edge. No Z: fill auto-closes, but the stroke
    // only draws the explicit edges, so the tab opens into the frame below.
    var d = 'M' + (x0 - e) + ',' + (h + e) +
      ' L' + (tx1 - k) + ',' + (ty + k) +
      ' A' + r + ',' + r + ' 0 0 1 ' + (tx1 + t) + ',' + ty +
      ' L' + (tx2 - t) + ',' + ty +
      ' A' + r + ',' + r + ' 0 0 1 ' + (tx2 + k) + ',' + (ty + k) +
      ' L' + (w - x0 + e) + ',' + (h + e);
    var svg = "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 " + w + ' ' + h + "'>" +
      "<path d='" + d + "' fill='white' stroke='black' stroke-width='" + sw + "' stroke-linejoin='round'/>" +
      '</svg>';
    return 'url("data:image/svg+xml,' + encodeURIComponent(svg) + '")';
  }

  function fitTabLabels() {
    var frames = Array.prototype.slice.call(document.querySelectorAll('.media-frame'));
    var labels = frames.map(function (frame) { return frame.querySelector('.tab-label'); });

    labels.forEach(function (label) {
      if (!label) return;
      label.style.maxWidth = 'none';
      label.style.width = 'max-content';
      label.style.fontSize = '';
    });

    // Pass 1: per tab, find the largest font size that fits that tab's own
    // frame. The smallest of those becomes the size every tab uses, so all
    // headers render identically instead of each shrinking independently.
    var uniformPx = null;
    frames.forEach(function (frame, i) {
      var label = labels[i];
      if (!label) return;
      var tabLeftPx = parseFloat(getComputedStyle(frame).getPropertyValue('--tab-left')) || 18;
      var maxBoxWidth = frame.getBoundingClientRect().width - tabLeftPx - 12;
      var guard = 0;
      while (guard < 40) {
        var textWidth = label.getBoundingClientRect().width;
        var targetWidth = textWidth;
        var currentPx = parseFloat(getComputedStyle(label).fontSize);
        if (targetWidth <= maxBoxWidth || currentPx <= 13) break;
        label.style.fontSize = (currentPx - 1) + 'px';
        guard++;
      }
      var fitPx = parseFloat(getComputedStyle(label).fontSize);
      if (uniformPx === null || fitPx < uniformPx) uniformPx = fitPx;
      label.style.fontSize = '';
    });

    // Pass 2: apply that one uniform size to every tab, then size each tab's
    // own box to fit its own (now-matching) text.
    frames.forEach(function (frame, i) {
      var label = labels[i];
      if (!label) return;
      label.style.fontSize = uniformPx + 'px';
      var textWidth = label.getBoundingClientRect().width;
      var tabLeftPx = parseFloat(getComputedStyle(frame).getPropertyValue('--tab-left')) || 18;
      var maxBoxWidth = frame.getBoundingClientRect().width - tabLeftPx - 12;
      var targetWidth = Math.min(Math.ceil(textWidth), Math.max(maxBoxWidth, 60));
      label.style.maxWidth = '';
      label.style.width = targetWidth + 'px';
      frame.style.setProperty('--tab-width', targetWidth + 'px');
      var tabHeight = label.getBoundingClientRect().height;
      label.style.backgroundImage = tabShapeUrl(targetWidth, tabHeight);
      label.style.backgroundSize = '100% 100%';
    });
  }
  fitTabLabels();
  window.addEventListener('resize', fitTabLabels);
  window.addEventListener('load', fitTabLabels);
  setTimeout(fitTabLabels, 300);
  setTimeout(fitTabLabels, 1000);
  setTimeout(fitTabLabels, 2500);
  if (document.fonts) {
    if (document.fonts.load) {
      document.fonts.load("400 42px 'Fanwood Text'").then(fitTabLabels).catch(function () {});
    }
    if (document.fonts.ready) {
      document.fonts.ready.then(fitTabLabels);
    }
  }
  // Fonts can finish swapping in after every timed check above (slow network,
  // artifact-viewer proxying); re-fit whenever a label's own rendered size
  // actually changes, so the tab shape can never go stale relative to its text.
  if (window.ResizeObserver) {
    var refitQueued = false;
    var ro = new ResizeObserver(function () {
      if (refitQueued) return;
      refitQueued = true;
      requestAnimationFrame(function () { refitQueued = false; fitTabLabels(); });
    });
    document.querySelectorAll('.tab-label').forEach(function (label) { ro.observe(label); });
  }
</script>
</body>
