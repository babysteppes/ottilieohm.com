<script is:inline>
  var allTabs = Array.prototype.slice.call(document.querySelectorAll('.tab[data-tab]'));

  function activateTab(target, opts) {
    opts = opts || {};
    allTabs.forEach(function (t) {
      var isTarget = t.getAttribute('data-tab') === target;
      t.classList.toggle('active', isTarget);
      t.setAttribute('aria-selected', isTarget ? 'true' : 'false');
      t.tabIndex = isTarget ? 0 : -1;
      if (isTarget && opts.focus) t.focus();
    });
    document.querySelectorAll('.tab-panel').forEach(function (panel) {
      panel.hidden = panel.getAttribute('data-panel') !== target;
    });
    if (opts.updateHash !== false) {
      history.replaceState(null, '', '#' + target);
    }
    if (typeof fitTabLabels === 'function') fitTabLabels();
  }

  allTabs.forEach(function (tab, i) {
    tab.addEventListener('click', function () {
      activateTab(tab.getAttribute('data-tab'), { updateHash: true });
    });
    tab.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        activateTab(tab.getAttribute('data-tab'), { updateHash: true });
        return;
      }
      var dir = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : e.key === 'Home' ? 'home' : e.key === 'End' ? 'end' : null;
      if (dir === null) return;
      e.preventDefault();
      var nextIndex = dir === 'home' ? 0 : dir === 'end' ? allTabs.length - 1 : (i + dir + allTabs.length) % allTabs.length;
      var nextTab = allTabs[nextIndex];
      activateTab(nextTab.getAttribute('data-tab'), { focus: true, updateHash: true });
    });
  });

  // Deep-linkable sections: #media or #contact opens straight to that tab,
  // and switching tabs updates the URL the same way, so the link is shareable.
  var initialHash = location.hash.replace('#', '');
  if (allTabs.some(function (t) { return t.getAttribute('data-tab') === initialHash; })) {
    activateTab(initialHash, { updateHash: false });
  }
  window.addEventListener('hashchange', function () {
    var hash = location.hash.replace('#', '');
    if (allTabs.some(function (t) { return t.getAttribute('data-tab') === hash; })) {
      activateTab(hash, { updateHash: false });
    }
  });

  document.querySelectorAll('[data-exp]').forEach(function (row) {
    var head = row.querySelector('.exp-row-head');
    function toggle() {
      var open = row.classList.toggle('open');
      head.setAttribute('aria-expanded', open ? 'true' : 'false');
    }
    row.addEventListener('click', function () {
      // don't collapse a role just because someone is selecting its text
      if (String(window.getSelection()).length) return;
      toggle();
    });
    head.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggle(); }
    });
  });

  // Contact form is a placeholder: it validates but sends nothing yet.
  (function () {
    var form = document.getElementById('contact-form');
    var status = document.getElementById('cf-status');
    if (!form) return;
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var bad = null;
      [].forEach.call(form.elements, function (el) {
        if (!el.name) return;
        var invalid = !el.checkValidity();
        el.setAttribute('aria-invalid', invalid ? 'true' : 'false');
        if (invalid && !bad) bad = el;
      });
      if (bad) {
        status.textContent = 'Please fill in every field' + (bad.type === 'email' ? ' with a valid email address.' : '.');
        bad.focus();
        return;
      }
      status.textContent = 'This form isn\u2019t connected yet, so nothing was sent. For now, please reach me on LinkedIn.';
    });
  })();

