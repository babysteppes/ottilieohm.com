  function initCarousel(root, data) {
    var idx = 0;
    var img = root.querySelector('.carousel-img');
    var frame = root.querySelector('.carousel-frame');
    var caption = root.querySelector('.carousel-caption');
    var dotsWrap = root.querySelector('.carousel-dots');
    var dots = [];
    data.forEach(function (item, i) {
      var d = document.createElement('span');
      d.className = 'dot' + (i === 0 ? ' active' : '');
      d.addEventListener('click', function () { show(i); });
      dotsWrap.appendChild(d);
      dots.push(d);
    });
    function show(i) {
      idx = (i + data.length) % data.length;
      var item = data[idx];
      img.src = item.src;
      img.style.objectFit = item.fit === 'contain' ? 'contain' : 'cover';
      caption.textContent = item.caption || '';
      if (item.ratio) frame.style.aspectRatio = item.ratio;
      dots.forEach(function (d, di) { d.classList.toggle('active', di === idx); });
    }
    root.querySelectorAll('.carousel-btn').forEach(function (btn) {
      btn.addEventListener('click', function () { show(idx + parseInt(btn.getAttribute('data-dir'), 10)); });
    });
    show(0);
  }

  document.querySelectorAll('[data-carousel]').forEach(function (root) {
    var key = root.getAttribute('data-carousel');
    if (carouselData[key]) initCarousel(root, carouselData[key]);
  });

